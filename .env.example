TEMPERATURE=0.0

# API
API_HOST=0.0.0.0
API_PORT=8000
# Set for a separate UI host/container; blank uses the local API port.
# API_BASE_URL=http://api:8000/api/v1

# PostgreSQL only. Local bootstrap writes ignored .local/database.env.
# Uncomment for manually configured PG; .env overrides the local bootstrap file.
# DATABASE_URL=postgresql+psycopg://aftercare_app:replace-me@127.0.0.1:55432/aftercare_demo
# READONLY_DATABASE_URL=postgresql+psycopg://aftercare_reader:replace-me@127.0.0.1:55432/aftercare_demo
DEFAULT_POLICY_ID=demo-return
READ_TRANSPORT=mcp
APP_TIMEZONE=local

# scripts.create_operator creates ignored local credentials; .env overrides them.
# OPERATOR_ID=demo_operator
# OPERATOR_TOKEN=replace-with-random-token
PLAN_TTL_HOURS=24
MAX_TOOL_ROUNDS=3
MAX_TOOL_CALLS=6
MAX_LLM_CALLS=7
LLM_TIMEOUT_SECONDS=30
READ_TIMEOUT_SECONDS=10
MCP_READ_TIMEOUT_SECONDS=10
ANALYSIS_TIMEOUT_SECONDS=120

