# Generate ignored .local/compose.env with: python -m scripts.configure_compose
# Do not copy real keys into this tracked template. DATABASE_URL passwords must be URL encoded.
COMPOSE_PROJECT_NAME=aftercarepilot
POSTGRES_ADMIN_PASSWORD=replace-with-random-bootstrap-password
BOOTSTRAP_DATABASE_URL=postgresql+psycopg://aftercare_bootstrap:replace-with-random-bootstrap-password@db:5432/postgres
DATABASE_URL=postgresql+psycopg://aftercare_app:replace-with-random-app-password@db:5432/aftercare_demo
READONLY_DATABASE_URL=postgresql+psycopg://aftercare_reader:replace-with-random-reader-password@db:5432/aftercare_demo
OPERATOR_ID=demo_operator
OPERATOR_TOKEN=replace-with-random-operator-token
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.8-max
OPENAI_BASE_URL=https://llm-z79r25z37dkxb5zu.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TEMPERATURE=0
APP_TIMEZONE=local
# Match the host system timezone; configure_compose resolves supported hosts.
TZ=Asia/Shanghai
API_PORT=8000
UI_PORT=8501
PG_PORT=5432
